  /* ------------------------------------------------------ */

  var LEFT_MAIN = '벨';                   // 이 인물은 항상 왼쪽
  var TYPE_MS = 32;                       // 글자 하나가 나오는 시간(밀리초)
  var LOCK_MS = 160;                      // 장면이 바뀐 직후 이 시간 동안은 탭을 무시
  var FONT_MAX = 4.4, FONT_MIN = 3.0;     // 대사 글자 크기 범위 (긴 대사는 자동으로 줄어듦)
  var STAGE_KEY = 'bokbok-vn-stage';      // 새로고침해도 인물 배치를 기억하는 저장 이름

  /* ---------- 이미지 미리 불러오기 (모바일 / 느린 회선용) ----------
     - 게임을 열면 배경 + 오프닝 첫 인물들을 먼저 받고, 다 받을 때까지 '불러오는 중' 화면을 보여줘.
       (받아둔 적이 있어서 금방 끝나면 이 화면은 아예 뜨지 않아)
     - 그 뒤 나머지 인물은 게임하는 동안 뒤에서 조금씩 받아.
     - 대사가 나올 때 그 인물 그림이 아직 안 왔으면, 그림이 올 때까지 잠깐 기다렸다가 대사를 시작해.
     - 앞으로 나올 몇 장면의 인물도 미리 받아둬. */
  var PRELOAD_CORE = ['벨', '수나', '남궁우', '야나기', '귤복복', '시시아', '11호', '빛나', '미야비', '아스트라'];  // 오프닝에 나오는 인물 (기본 그림)
  var PRELOAD_HUB = ['레미엘', '루시아', '시드', '자오', '앨리스', '클라렛'];   // 용의자 선택 화면에서 각 루트에 처음 나오는 인물 (오프닝 인물 다음으로 받음)
  var PRELOAD_GATE = 5;                   // 위 목록 중 앞에서부터 몇 명을 다 받아야 게임을 열지 (나머지는 게임하면서 바로 뒤에서 받음)
  var PRELOAD_PARALLEL = 2;               // 뒤에서 받을 때 동시에 받는 개수 (느린 회선의 폰을 위해 적게)
  var LOADING_DELAY_MS = 250;             // 이 시간 안에 끝나면 '불러오는 중' 화면을 띄우지 않음
  var LOADING_STUCK_MS = 8000;            // 이 시간이 지나도 안 끝나면 '그냥 시작하기' 버튼이 나옴
  var WAIT_MAX_MS = 4000;                 // 대사를 시작하기 전에 인물 그림을 기다려주는 최대 시간
  var LOOKAHEAD = 4;                      // 앞으로 몇 장면 뒤까지 나올 인물을 미리 받을지

  var root, slotL, slotR, nameEl, textEl, chEl;
  var stage = { L: null, R: null, last: null };   // last: 가장 최근에 말한 사람
  var lastPassage = null;
  var typing = null;                      // { timer, chars, i }
  var advanceLink = null;
  var lockUntil = 0;

  function imgUrl(file) { return encodeURI(IMAGE_BASE + file); }
  function canon(n) { return ALIAS[n] || n; }
  function hasChar(n) { return !!CHAR[String(n).split('#')[0]]; }
  function dkey(n) { var m = CHAR[n]; return m ? n + '#' + m.base : n; }   // 인물 이름 -> 기본 그림 이름표 ('벨#진지')
  /* 장면마다 인물이 지을 표정: 장면 글 맨 위에 <span data-bx="이름:표정"></span> 를 넣어서 정함. 표시가 없는 인물은 기본 그림(base).
     - <span data-bx="시드:노말"></span>  ->  시드만 '노말' 그림. 나란히 여러 개 넣어도 돼. (그 인물에게 없는 표정 이름은 무시됨)
     - <span data-bx="노말"></span>       ->  이름 없이 쓰면 '노말' 그림이 있는 인물은 누구나 (쓰지 않는 걸 추천)
     표정 그림은 CHAR 의 그 인물 imgs 에 적어두고, 파일 이름은 '이름_표정.webp' */
  var sceneExprs = [];                    // 지금 장면의 표정 표시들: [{ who, expr }]
  function parseBx(raw) {
    var s = String(raw), i = s.indexOf(':');
    return i < 0 ? { who: null, expr: s.trim() } : { who: canon(s.slice(0, i).trim()), expr: s.slice(i + 1).trim() };
  }
  function sceneExprFor(n) {              // 지금 장면에서 이 인물이 지을 표정 이름 (없으면 null)
    var m = CHAR[n], bare = null, i;
    if (!m) return null;
    for (i = 0; i < sceneExprs.length; i++) {
      var b = sceneExprs[i];
      if (m.imgs.indexOf(b.expr) < 0) continue;
      if (b.who === n) return b.expr;     // 이름을 적은 표시가 우선
      if (!b.who && !bare) bare = b.expr;
    }
    return bare;
  }
  function exprKey(n) {                   // 인물 이름 -> 그림 이름표 ('벨#진지')
    var m = n && CHAR[n];
    if (!m) return n || null;
    return n + '#' + (sceneExprFor(n) || m.base);
  }

  function el(tag, cls) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    return e;
  }

  function saveStage() {
    try { sessionStorage.setItem(STAGE_KEY, JSON.stringify(stage)); } catch (e) {}
  }
  function loadStage() {
    try {
      var s = JSON.parse(sessionStorage.getItem(STAGE_KEY) || 'null');
      if (s && typeof s === 'object') { stage.L = s.L || null; stage.R = s.R || null; stage.last = s.last || null; }
    } catch (e) {}
  }

  function build() {
    if (root) return;
    root = el('div');
    root.id = 'vn-root';
    root.hidden = true;
    slotL = el('div', 'vn-slot vn-left');
    slotR = el('div', 'vn-slot vn-right');
    var box = el('div', 'vn-box');
    nameEl = el('div', 'vn-name');
    textEl = el('div', 'vn-text');
    box.appendChild(nameEl);
    box.appendChild(textEl);
    chEl = el('div', 'vn-choices');
    chEl.hidden = true;
    root.appendChild(slotL);
    root.appendChild(slotR);
    root.appendChild(chEl);
    root.appendChild(box);
    document.body.appendChild(root);
    root.addEventListener('click', onTap);
    document.addEventListener('keydown', function (e) {
      if (document.body.classList.contains('hm-open')) return;
      var onHub = !!(hm.back && !hm.back.hidden);          // 용의자 선택 화면처럼 대사창은 없지만 이전 버튼은 있는 화면
      if (!document.body.classList.contains('vn-on') && !onHub) return;
      if (document.body.classList.contains('vn-on') && (e.key === ' ' || e.key === 'Enter')) { e.preventDefault(); onTap(); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); goBack(); }
    });
  }

  /* 패시지에서 대사 글자와 '다음' 링크를 뽑아냄. 대화 장면이 아니면 null
     multi 가 true 면(선택지 / 용의자 선택 화면) 링크가 여러 개여도 되고, 링크들은 choices 로 돌려줘.
     링크가 아닌 <span data-lock="1">...</span> 는 '아직 못 고르는 선택지' 로 lock 에 글자만 돌려줘. */
  function extract(p, multi) {
    var links = Array.prototype.filter.call(p.querySelectorAll('tw-link'), function (l) { return !l.closest('tw-include'); });
    if (multi ? !links.length : links.length !== 1) return null;
    var lockEl = multi ? p.querySelector('[data-lock]') : null;
    var clone = p.cloneNode(true);
    var junk = clone.querySelectorAll(
      'tw-sidebar, tw-include, script, style, tw-link, tw-expression[name="link-goto"], tw-consecutive-br, [data-lock]');
    Array.prototype.forEach.call(junk, function (n) { n.parentNode && n.parentNode.removeChild(n); });
    Array.prototype.forEach.call(clone.querySelectorAll('br'), function (b) {
      b.parentNode.replaceChild(document.createTextNode('\n'), b);
    });
    var text = (clone.textContent || '').replace(/[ \t]+\n/g, '\n').replace(/\n{2,}/g, '\n').trim();
    var res = { text: text, link: multi ? null : links[0] };
    if (multi) {
      res.choices = links.map(function (l) {
        return { label: l.textContent.replace(/^\s+|\s+$/g, ''), el: l };
      });
      res.lock = lockEl ? lockEl.textContent.replace(/\s+/g, ' ').trim() : null;
    }
    return res;
  }

  /* '벨: 대사' 형식에서 화자와 대사를 분리 */
  function parseSpeaker(text) {
    var lines = text.split('\n');
    for (var i = 0; i < lines.length; i++) {
      var m = lines[i].match(/^([^\s:()（）]{1,10}):\s*(.*)$/);
      if (m) {
        lines[i] = m[2];
        return { speaker: m[1], body: lines.join('\n').trim() };
      }
    }
    return { speaker: null, body: text };
  }

  /* 누가 화면에 나오는지 (자리 규칙)
     - 기본은 '가장 최근에 말한 사람 + 지금 말하는 사람'. 화면에는 최대 두 명이고, 벨은 나오면 항상 왼쪽이야.
     - 이미 나와 있는 사람은 자리를 지키고, 새로 오는 사람은 '최근에 말하지 않은 쪽'이 빠진 자리에 들어가.
       (벨이 빠지면 벨의 왼쪽 자리에 새 사람이 와)
     - 정황상 이 사람이 같이 나와야 할 때는 장면 글에 <span data-stage="벨,수나"></span> 를 넣으면 그 장면은 지정한 사람들로 보여줘. */
  function seatOf(name) { return stage.L === name ? 'L' : (stage.R === name ? 'R' : null); }

  function addToStage(s) {
    if (s === LEFT_MAIN) {                // 벨은 항상 왼쪽
      if (!stage.L) stage.L = s;
      else if (!stage.R) { stage.R = stage.L; stage.L = s; }
      else if (stage.last === stage.L) { stage.R = stage.L; stage.L = s; }   // 왼쪽 사람이 방금 말한 사람이면 오른쪽으로 옮기고, 오른쪽(덜 최근) 사람이 빠짐
      else stage.L = s;                   // 오른쪽 사람이 방금 말한 사람이면 그대로 두고 왼쪽 사람이 빠짐
      return;
    }
    if (!stage.L) stage.L = s;
    else if (!stage.R) stage.R = s;
    else if (stage.last === stage.L) stage.R = s;   // 최근에 말 안 한 쪽이 빠짐
    else stage.L = s;
  }

  /* 꼬리, 날개 때문에 왼쪽에 서면 옆 사람 얼굴을 가리는 인물은 항상 오른쪽 자리에 섬 (오른쪽에 서면 가려짐이 없음을 전부 검사해 둠) */
  var RIGHT_ONLY = { '귤복복': true };
  function keepSeats() {
    if (stage.L && RIGHT_ONLY[stage.L] && !RIGHT_ONLY[stage.R]) { var t = stage.L; stage.L = stage.R; stage.R = t; }
  }

  function placeSpeaker(name) {
    if (!name) return;
    var s = canon(name);
    if (!seatOf(s)) addToStage(s);
    stage.last = s;
    keepSeats();
    saveStage();
  }

  /* 이 장면은 지정한 사람들(최대 두 명)로 보여줌 */
  function applyCast(list) {
    list = list.filter(function (n) { return n && CHAR[n]; }).slice(0, 2);
    if (!list.length) return;
    ['L', 'R'].forEach(function (k) { if (stage[k] && list.indexOf(stage[k]) < 0) stage[k] = null; });
    list.forEach(function (n) { if (!seatOf(n)) addToStage(n); });
    keepSeats();
    saveStage();
  }

  function placeholder(name, missing) {
    var ph = el('div', 'vn-ph');
    ph.textContent = name;
    if (missing) {
      var sub = el('div', 'vn-ph-sub');
      sub.textContent = '(이미지를 못 찾았어)';
      ph.appendChild(sub);
    }
    return ph;
  }

  function charUrl(file) { return encodeURI(CHAR_BASE + file); }

  var badUrls = {};                       // 이미 없다고 확인된 주소는 다시 찾지 않음

  /* 인물 이미지 후보: '이름_표정.webp'. key 는 '시드#노말' 처럼 표정을 붙여 부름 (표정을 안 붙이면 기본 그림) */
  function candidatesFor(key) {
    var kp = String(key).split('#');
    var name = kp[0];
    var out = [];
    var names = [name];
    Object.keys(ALIAS).forEach(function (a) { if (ALIAS[a] === name) names.push(a); });
    if (CHAR[name]) {
      var ex = kp[1] || CHAR[name].base;
      names.forEach(function (n) {
        if (WEB_MODE) out.push({ url: charUrl(n + '_' + ex + '.webp') });
        out.push({ url: charUrl(n + '_' + ex + '.png') });
        if (!WEB_MODE) out.push({ url: charUrl(n + '_' + ex + '.webp') });   // 내 컴퓨터 폴더에 webp 만 있는 인물도 찾도록
      });
    }
    return out.filter(function (c) { return !badUrls[c.url]; });
  }

  /* ================= 인물 그림 미리 받기 ================= */
  var sprites = {};                       // 인물 이름 -> { state: 'loading' | 'ok' | 'missing', cbs: [...], img }
  var plainKeep = [];                     // 배경처럼 인물이 아닌 그림을 메모리에 붙잡아 둠
  var bgPump = null;                      // 뒤에서 받기를 이어가는 함수 (backgroundPreload 가 채움)
  var urgent = 0;                         // 지금 화면에 꼭 필요해서 기다리는 그림 수 (이동안에는 뒤에서 받기를 멈춤)

  /* 그림을 다 받은 뒤 화면에 그릴 준비(디코딩)까지 끝내고 알려줌. 지원하지 않는 브라우저는 다 받은 시점에 알려줌 */
  function decodeThen(im, cb) {
    var called = false;
    function fin() { if (!called) { called = true; cb(); } }
    try {
      if (im.decode) { im.decode().then(fin, fin); setTimeout(fin, 3000); return; }
    } catch (e) {}
    fin();
  }

  /* 인물 한 명의 그림을 받아둠. 이미 받았거나 받는 중이면 그 결과를 기다렸다가 cb 를 부름 */
  function loadSprite(name, cb) {
    var e = sprites[name];
    if (e && e.state !== 'loading') { if (cb) cb(e); return; }
    if (e) { if (cb) e.cbs.push(cb); return; }
    e = sprites[name] = { state: 'loading', cbs: cb ? [cb] : [], img: null };
    var cands = candidatesFor(name), i = 0;
    function finish(state) {
      e.state = state;
      var list = e.cbs;
      e.cbs = [];
      for (var k = 0; k < list.length; k++) list[k](e);
    }
    function next() {
      if (i >= cands.length) { finish('missing'); return; }
      var c = cands[i++];
      var im = new Image();
      var t0 = Date.now(), retried = false;
      im.onload = function () { decodeThen(im, function () { e.img = im; finish('ok'); }); };
      im.onerror = function () {
        // 회선이 끊겼거나 오래 걸리다 실패한 경우는 한 번 더 시도 (파일이 없는 경우는 금방 실패하니까 바로 다음 후보로)
        if (!retried && (Date.now() - t0 > 1500 || (navigator.onLine === false))) {
          retried = true;
          setTimeout(function () { im.src = c.url + (c.url.indexOf('?') < 0 ? '?' : '&') + 'r=1'; }, 600);
          return;
        }
        badUrls[c.url] = true;
        next();
      };
      im.src = c.url;
    }
    next();
  }

  /* 배경 등 인물이 아닌 그림 */
  function preloadPlain(url, cb) {
    var im = new Image(), done = false;
    function fin() { if (!done) { done = true; cb(); } }
    im.onload = function () { decodeThen(im, fin); };
    im.onerror = fin;
    plainKeep.push(im);
    im.src = url;
  }

  /* 타이틀 그림: 받았는지 여부를 기억해 둠 (없으면 타이틀 화면이 글자만 있는 모양으로 대신 나옴) */
  var titleArt = { ok: null, edges: false };

  /* 그림 맨 위/맨 아래 줄의 색을 읽어서 화면이 그림보다 길 때 남는 위아래를 그 색으로 이어 붙임.
     (파일로 열어서 브라우저가 읽기를 막으면 대신 그림을 흐리게 늘려서 채움) */
  function sampleTitleEdges(im) {
    try {
      var W = 8, H = 100, c = document.createElement('canvas');
      c.width = W;
      c.height = H;
      var g = c.getContext('2d');
      g.imageSmoothingQuality = 'high';
      g.drawImage(im, 0, 0, W, H);
      var d = g.getImageData(0, 0, W, H).data;
      var band = function (row) {
        var out = [];
        for (var x = 0; x < W; x++) {
          var i = (row * W + x) * 4;
          out.push('rgb(' + d[i] + ',' + d[i + 1] + ',' + d[i + 2] + ')');
        }
        return 'linear-gradient(90deg,' + out.join(',') + ')';
      };
      document.documentElement.style.setProperty('--tt-top', band(0));
      document.documentElement.style.setProperty('--tt-bot', band(H - 1));
      titleArt.edges = true;
    } catch (e) { titleArt.edges = false; }
  }

  function loadTitleArt(cb) {
    var im = new Image(), done = false;
    function fin(ok) {
      titleArt.ok = ok;
      if (ok) sampleTitleEdges(im);
      applyTitleArt();
      if (!done) { done = true; if (cb) cb(); }
    }
    im.onload = function () { decodeThen(im, function () { fin(true); }); };
    im.onerror = function () { fin(false); };
    plainKeep.push(im);
    im.src = imgUrl(TITLE_FILE);
  }

  /* ---------- 불러오는 중 화면 ----------
     나중에 예쁜 화면으로 바꾸고 싶으면 buildLoading / setLoading / hideLoading 세 함수와 스타일시트의 #ld-root 부분만 바꾸면 돼. */
  var ld = { root: null, fill: null, msg: null, skip: null, onSkip: null };

  function buildLoading() {
    if (ld.root) return;
    var r = el('div');
    r.id = 'ld-root';
    r.hidden = true;
    var title = el('div', 'ld-title');
    title.textContent = '귤복복 살인사건';
    var bar = el('div', 'ld-bar');
    ld.fill = el('div', 'ld-fill');
    bar.appendChild(ld.fill);
    ld.msg = el('div', 'ld-msg');
    ld.msg.textContent = '불러오는 중… 0%';
    ld.skip = el('button', 'gl-btn ld-skip');
    ld.skip.type = 'button';
    ld.skip.textContent = '그냥 시작하기';
    ld.skip.hidden = true;
    ld.skip.addEventListener('click', function () { if (ld.onSkip) ld.onSkip(); });
    r.appendChild(title);
    r.appendChild(bar);
    r.appendChild(ld.msg);
    r.appendChild(ld.skip);
    document.body.appendChild(r);
    ld.root = r;
  }

  function setLoading(done, total) {
    if (!ld.root) return;
    var pct = total ? Math.min(100, Math.round(100 * done / total)) : 100;
    ld.fill.style.width = pct + '%';
    ld.msg.textContent = '불러오는 중… ' + pct + '%';
  }

  function hideLoading() {
    if (ld.root) ld.root.hidden = true;
  }

  /* 게임을 열 때 한 번: 배경 + 오프닝 첫 인물들을 받는다. 다 받으면 화면을 열고, 나머지는 뒤에서 받는다 */
  function startPreload() {
    var core = PRELOAD_CORE.filter(hasChar).map(dkey);
    var gate = core.slice(0, PRELOAD_GATE);
    var total = gate.length + 2, done = 0, finished = false;
    var showTimer = setTimeout(function () {
      if (finished) return;
      buildLoading();
      ld.onSkip = finish;
      ld.root.hidden = false;
      setLoading(done, total);
    }, LOADING_DELAY_MS);
    var stuckTimer = setTimeout(function () { if (!finished && ld.skip) ld.skip.hidden = false; }, LOADING_STUCK_MS);
    function finish() {
      if (finished) return;
      finished = true;
      clearTimeout(showTimer);
      clearTimeout(stuckTimer);
      hideLoading();
      backgroundPreload();
    }
    function tick() {
      done++;
      setLoading(done, total);
      if (done >= total) finish();
    }
    preloadPlain(imgUrl(BG_FILE), tick);
    loadTitleArt(tick);
    gate.forEach(function (n) { loadSprite(n, tick); });
  }

  /* 나머지 인물을 게임하는 동안 뒤에서 조금씩 받는다 */
  function backgroundPreload() {
    // 순서: 오프닝 인물 중 아직 안 받은 사람 -> 용의자 루트 첫 인물 -> 나머지 인물
    var first = PRELOAD_CORE.concat(PRELOAD_HUB).filter(hasChar).map(dkey);
    var rest = first.slice();
    Object.keys(CHAR).forEach(function (n) { if (rest.indexOf(dkey(n)) < 0) rest.push(dkey(n)); });      // 나머지 인물의 기본 그림
    Object.keys(CHAR).forEach(function (n) {                                                            // 그다음 표정별 그림 (예: 시드#노말)
      CHAR[n].imgs.forEach(function (x) { if (rest.indexOf(n + '#' + x) < 0) rest.push(n + '#' + x); });
    });
    var active = 0;
    function pump() {
      if (urgent > 0) return;             // 지금 화면에 필요한 그림을 기다리는 중이면 양보
      while (active < PRELOAD_PARALLEL && rest.length) {
        var n = rest.shift();
        if (sprites[n]) continue;         // 앞 장면 미리보기로 이미 받았거나 받는 중이면 건너뜀
        active++;
        loadSprite(n, function () { active--; pump(); });
      }
    }
    bgPump = pump;
    pump();
  }

  /* ---------- 앞으로 나올 장면의 인물 미리 받기 ----------
     Harlowe 가 숨겨둔 패시지 원문을 읽어서, 지금 장면에서 링크로 이어지는 몇 장면 앞까지의 화자를 찾는다. */
  var pIndex = null;                      // 패시지 이름 -> { tags, text }
  function passageIndex() {
    if (pIndex) return pIndex;
    pIndex = {};
    var list = document.querySelectorAll('tw-passagedata');
    for (var i = 0; i < list.length; i++) {
      pIndex[list[i].getAttribute('name')] = { tags: list[i].getAttribute('tags') || '', text: list[i].textContent || '' };
    }
    return pIndex;
  }

  function speakerOf(text) {
    var lines = text.replace(/\[\[[\s\S]*?\]\]/g, '').split('\n');
    for (var i = 0; i < lines.length; i++) {
      var m = lines[i].match(/^([^\s:()（）]{1,10}):\s*(.*)$/);
      if (m) return canon(m[1]);
    }
    return null;
  }

  function linksOf(text) {
    var out = [], re = /\[\[([\s\S]*?)\]\]/g, m;
    while ((m = re.exec(text))) {
      var t = m[1], k = t.indexOf('->');
      if (k >= 0) t = t.slice(k + 2);
      else { k = t.indexOf('<-'); if (k >= 0) t = t.slice(0, k); }
      out.push(t.replace(/^\s+|\s+$/g, ''));
    }
    return out;
  }

  function prefetchAhead(link) {
    try {
      var idx = passageIndex();
      // Harlowe 링크에는 대상 이름 속성이 없고 글자만 있음. 대화 장면의 링크는 글자가 곧 대상 패시지 이름이라 그걸 씀
      var first = link && link.textContent.replace(/^\s+|\s+$/g, '');
      if (!first || !idx[first]) return;
      var queue = [first], seen = {}, depth = 0;
      while (queue.length && depth < LOOKAHEAD) {
        var next = [];
        for (var q = 0; q < queue.length; q++) {
          var name = queue[q], p = idx[name];
          if (!p || seen[name]) continue;
          seen[name] = true;
          var tags = p.tags.split(/\s+/);
          if (tags.indexOf('vn') < 0 && tags.indexOf('vn-choice') < 0) continue;   // 대화 장면이 아니면 여기서 멈춤
          var sp = speakerOf(p.text), tagged = {};
          var bm, reBx = /data-bx="([^"]+)"/g;               // 다음 장면에서 인물들이 지을 표정 그림도 미리 받음
          while ((bm = reBx.exec(p.text))) {
            (function (bx) {
              Object.keys(CHAR).forEach(function (n) {
                if (CHAR[n].imgs.indexOf(bx.expr) >= 0 && (!bx.who || bx.who === n)) { loadSprite(n + '#' + bx.expr); tagged[n] = true; }
              });
            })(parseBx(bm[1]));
          }
          if (sp && CHAR[sp] && !tagged[sp]) loadSprite(dkey(sp));
          next = next.concat(linksOf(p.text));
        }
        queue = next;
        depth++;
      }
    } catch (e) {}
  }

  /* 한 자리(L / R)에 선 인물의 그림을 놓는 위치와 크기를 계산해서 img 에 적용.
     세로는 대사창 윗선(화면 높이의 72%)이 기준이고, 크기와 가로 위치는 화면 폭(--u = 폭의 1%)이 기준이라 폰 비율이 달라도 같은 모양이야. */
  function placeSprite(img, key, seat, opt) {
    var kp = String(key).split('#'), name = kp[0], m = CHAR[name], expr = kp[1] || m.base;
    var flip = !!(opt && opt.flip), dx = (opt && opt.dx) || 0;
    var h = m.h, w = h * m.ar;
    var ex = flip ? 1 - m.ex : m.ex;
    var left = (seat === 'L' ? SEAT_L : m.fx) + dx - ex * w;
    var top = m.fy - m.ey * h;
    var a = m.adj && m.adj[expr];
    if (a) { left += (flip ? -a[1] : a[1]) * m.h; top += a[2] * m.h; h *= a[0]; }
    img.style.height = 'calc(var(--u) * ' + h.toFixed(3) + ')';
    img.style.width = 'auto';
    img.style.left = 'calc(var(--u) * ' + left.toFixed(3) + ')';
    img.style.top = 'calc(100% - var(--box-h) + var(--u) * ' + top.toFixed(3) + ')';
    img.style.transform = flip ? 'scaleX(-1)' : '';
  }

  function flipFor(n, pr) {
    var m = n && CHAR[n];
    if (!m) return false;
    var f = !!m.flip;
    if (pr && pr.t && FLIP_OK[n]) f = !f;
    return f;
  }

  /* 두 자리를 한꺼번에 놓음: 조합에 맞는 앞뒤 순서 / 옮김 / 반전을 PAIR 표에서 찾아서 적용 */
  function layoutStage(kL, kR) {
    var nL = stage.L, nR = stage.R;
    var pr = (nL && nR) ? PAIR[nL + '|' + nR] : null;
    setSlot(slotL, kL, 'L', { flip: flipFor(nL, pr), dx: pr ? (pr.a || 0) : 0 });
    setSlot(slotR, kR, 'R', { flip: flipFor(nR, pr), dx: pr ? (pr.b || 0) : 0 });
    var rFront = !!(pr && pr.f === 'R');
    slotL.style.zIndex = rFront ? 1 : 2;
    slotR.style.zIndex = rFront ? 2 : 1;
  }

  /* 같은 인물이 같은 자리에 계속 서 있으면 그림을 지웠다 다시 그리지 않고 그대로 둠 (깜빡임 방지) */
  function setSlot(slot, key, seat, opt) {
    var sig = key ? key + '|' + (opt.flip ? 1 : 0) + '|' + (opt.dx || 0) : '';
    if (slot.getAttribute('data-name') === sig && (!sig || slot.firstChild)) return;
    if (key && slot.getAttribute('data-key') === key && slot.firstChild && slot.firstChild.tagName === 'IMG') {   // 그림은 그대로, 위치만 바뀜
      placeSprite(slot.firstChild, key, seat, opt);
      slot.setAttribute('data-name', sig);
      return;
    }
    slot.setAttribute('data-name', sig);
    slot.setAttribute('data-key', key || '');
    fillSlot(slot, key, seat, opt);
  }

  function fillSlot(slot, key, seat, opt) {
    slot.innerHTML = '';
    slot.classList.remove('vn-norm');
    if (!key) return;
    var cands = candidatesFor(key);
    var idx = 0;

    function tryNext() {
      if (idx >= cands.length) {
        slot.innerHTML = '';
        slot.classList.remove('vn-norm');
        slot.appendChild(placeholder(key, true));
        if (window.console) console.warn('이미지를 못 찾았어: ' + key);
        return;
      }
      var cand = cands[idx];
      slot.innerHTML = '';
      var img = el('img');
      img.alt = key;
      slot.classList.add('vn-norm');
      img.className = 'vn-sprite';
      placeSprite(img, key, seat, opt);
      img.onerror = function () {
        badUrls[cand.url] = true;
        idx++;
        tryNext();
      };
      slot.appendChild(img);
      img.src = cand.url;
    }
    tryNext();
  }

  function stopTyping() {
    if (typing) { clearInterval(typing.timer); typing = null; }
  }

  function finishTyping() {
    if (!typing) return;
    textEl.textContent = typing.chars.join('');
    stopTyping();
    typedEnd();
  }

  /* ===== 선택지 화면 =====
     선택지가 있는 장면('vn-choice' 태그, 용의자 선택의 'hub' 태그)은 보통 장면처럼 인물과 대사창이 나오고,
     대사가 다 나오면 대사창 위쪽 빈 공간에 반투명한 검은 띠가 위에서부터 차례로 나타나서 그 위에 글자로 선택지가 떠.
     (띠는 위아래로 고르게 퍼짐 / 글자는 링크 글자 그대로 / 누르면 패시지 안의 링크를 대신 눌러줌)
     - 링크가 아닌 <span data-lock="1">글자</span> 는 '아직 못 고르는 선택지' 로 흐리게 나옴 (누를 수 없음) */
  var pendingChoice = null;               // 대사가 끝나면 띄울 선택지: { items, lock }
  function hideChoices() {
    pendingChoice = null;
    if (chEl) { chEl.hidden = true; chEl.innerHTML = ''; }
  }
  function typedEnd() {
    var c = pendingChoice;
    if (!c || !chEl) return;
    pendingChoice = null;
    chEl.innerHTML = '';
    chEl.style.setProperty('--n', c.items.length + (c.lock ? 1 : 0));
    c.items.forEach(function (it, i) {
      var b = el('button', 'vn-ch');
      b.type = 'button';
      b.style.setProperty('--i', i);
      var s = el('span', 'vn-ch-t');
      s.textContent = it.label;
      b.appendChild(s);
      b.addEventListener('click', function (e) {
        e.stopPropagation();
        if (Date.now() < lockUntil) return;
        if (it.el && document.contains(it.el)) it.el.click();
      });
      chEl.appendChild(b);
    });
    if (c.lock) {
      var d = el('div', 'vn-ch vn-ch-lock');
      d.style.setProperty('--i', c.items.length);
      var ds = el('span', 'vn-ch-t');
      ds.textContent = c.lock;
      d.appendChild(ds);
      chEl.appendChild(d);
    }
    chEl.hidden = false;
  }

  /* 대사가 길어서 칸을 넘치면 글자 크기를 조금씩 줄임 */
  function fitText(full) {
    var size = FONT_MAX;
    textEl.style.fontSize = 'calc(var(--u) * ' + size + ')';
    textEl.textContent = full;
    while (size > FONT_MIN && textEl.scrollHeight > textEl.clientHeight + 1) {
      size = Math.round((size - 0.2) * 10) / 10;
      textEl.style.fontSize = 'calc(var(--u) * ' + size + ')';
    }
    textEl.textContent = '';
  }

  function startTyping(body) {
    stopTyping();
    fitText(body);
    var chars = Array.from(body);
    if (!chars.length) return;
    typing = { chars: chars, i: 0, timer: null };
    typing.timer = setInterval(function () {
      if (!typing) return;
      typing.i++;
      textEl.textContent = typing.chars.slice(0, typing.i).join('');
      if (typing.i >= typing.chars.length) { stopTyping(); typedEnd(); }
    }, TYPE_MS);
  }

  function onTap() {
    if (Date.now() < lockUntil) return;
    if (typing) { finishTyping(); return; }
    if (advanceLink && document.contains(advanceLink)) advanceLink.click();
  }

  function leaveVN(keepStage) {
    stopTyping();
    hideChoices();
    advanceLink = null;
    if (!keepStage) { stage.L = stage.R = stage.last = null; saveStage(); }
    document.body.classList.remove('vn-on');
    if (root) root.hidden = true;
  }

  /* ================= 엔딩 갤러리 =================
     'gallery' 태그가 붙은 패시지에서 동작해. (지금은 '엔딩 갤러리' 패시지 하나)
     - 한 페이지에 엔딩 6개, 총 3페이지 (1~6 / 7~12 / 13~16 + 진엔딩)
     - 본 엔딩만 그림이 보이고, 못 본 엔딩은 ??? 로 가려짐
     - 그림을 누르면 거의 꽉 찬 크기로 보이고, 화면 아무 데나 누르면 닫힘
     - 오른쪽 위 집 모양 버튼: 타이틀 화면으로 (패시지 안의 링크를 대신 눌러줌) */

  // 엔딩 이미지가 들어 있는 폴더 (내 컴퓨터에서 열 때 / 웹에 올렸을 때)
  var ENDING_LOCAL_BASE = 'file:///C:/Users/pumha/Desktop/귤복복 살인사건제작/완성본/실제 제작/엔딩 이미지/';
  var ENDING_WEB_BASE = 'images/endings/';
  var ENDING_BASE = (location.protocol === 'file:') ? ENDING_LOCAL_BASE : ENDING_WEB_BASE;

  // 엔딩 번호 -> 이미지 파일 이름. 1~16은 일반 엔딩, 17은 진엔딩.
  // 그림이 없는 엔딩은 적지 않으면 돼. (해금되면 '이미지 준비 중' 칸으로 나와)
  // 표에는 .png 이름을 적어두면 돼. 같은 이름의 .webp(최적화본)가 있으면 그걸 먼저 쓰고, 없으면 .png 를 써.
  var ENDING_FILES = {
     1: '레미는 잘못없어.png',
     2: '레미 머리 깡.png',
     3: '이블린 신나!.png',
     4: '수나 멜트다운.png',
     5: '인생망한 벨.png',
     6: '마미루.png',
     7: '선로 전환기에 접근.png',
     8: '트리거는 정실이야.png',
     9: '잡혀가는 다이아린.png',
    10: '아재개그 싫어.png',
    11: '미각사냥꾼.png',
    12: '레제.png',
    13: '앨리스표독.png',
    14: '앨리스의 죽음.png',
    15: '사람이 죽는다고.png',
    16: '경고합니다.png',
    17: '트루 엔딩.png'
  };

  // 썸네일에서 보이는 세로 위치 (0% = 맨 위, 100% = 맨 아래). 적지 않은 엔딩은 맨 위(0%)가 보여.
  // 얼굴이 위쪽에 있는 그림이 대부분이라 기본을 위쪽으로 했고, 묘비처럼 가운데가 중요한 그림만 따로 적어.
  var ENDING_FOCUS = { 13: '50%', 14: '60%' };

  var G_NORMAL = 16;      // 일반 엔딩 개수
  var G_TRUE = 17;        // 진엔딩 번호
  var G_TOTAL = 17;       // 전체 칸 수
  var G_PER_PAGE = 6;     // 한 페이지 칸 수
  var G_PAGES = Math.ceil(G_TOTAL / G_PER_PAGE);

  var ICON_HOME = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2 2.8 11.2h2.6V20h5v-5.6h3.2V20h5v-8.8h2.6z" fill="currentColor"/></svg>';
  var ICON_PREV = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4 7 12l8 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  var ICON_NEXT = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 4 8 8-8 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  var gl = {
    root: null, grid: null, count: null, label: null,
    prev: null, next: null, viewer: null, viewerImg: null,
    page: 1, homeLink: null, urls: {}
  };

  function endingUrl(file) { return encodeURI(ENDING_BASE + file); }

  function endingCandidates(id) {
    var f = ENDING_FILES[id];
    if (!f) return [];
    var webp = f.replace(/\.png$/i, '.webp');
    return webp === f ? [f] : [webp, f];
  }

  function readUnlocked() {
    var s = {};
    try {
      (window.BB ? BB.load() : []).forEach(function (v) { s[v] = true; });
    } catch (e) {}
    return s;
  }

  function glGuard() { return Date.now() >= lockUntil; }

  function glButton(cls, label, svg, onClick) {
    var b = el('button', cls);
    b.type = 'button';
    b.setAttribute('aria-label', label);
    b.innerHTML = svg;
    b.addEventListener('click', function () { if (glGuard()) onClick(); });
    return b;
  }

  function buildGallery() {
    if (gl.root) return;
    var root = el('div');
    root.id = 'gl-root';
    root.hidden = true;

    var head = el('div', 'gl-head');
    var title = el('div', 'gl-title');
    title.appendChild(document.createTextNode('엔딩 갤러리'));
    gl.count = el('span', 'gl-count');
    title.appendChild(gl.count);
    head.appendChild(title);
    head.appendChild(glButton('gl-btn gl-home', '타이틀 화면으로', ICON_HOME, goHome));

    gl.grid = el('div', 'gl-grid');

    var foot = el('div', 'gl-foot');
    gl.prev = glButton('gl-btn gl-nav', '이전 페이지', ICON_PREV, function () { flip(-1); });
    gl.label = el('div', 'gl-page');
    gl.next = glButton('gl-btn gl-nav', '다음 페이지', ICON_NEXT, function () { flip(1); });
    foot.appendChild(gl.prev);
    foot.appendChild(gl.label);
    foot.appendChild(gl.next);

    gl.viewer = el('div', 'gl-viewer');
    gl.viewer.hidden = true;
    gl.viewerImg = el('img');
    gl.viewerImg.alt = '';
    gl.viewer.appendChild(gl.viewerImg);
    gl.viewer.addEventListener('click', function (e) { e.stopPropagation(); closeViewer(); });

    root.appendChild(head);
    root.appendChild(gl.grid);
    root.appendChild(foot);
    root.appendChild(gl.viewer);
    document.body.appendChild(root);
    gl.root = root;

    document.addEventListener('keydown', function (e) {
      if (!document.body.classList.contains('gl-on')) return;
      if (!gl.viewer.hidden) {
        if (e.key === 'Escape') { e.preventDefault(); closeViewer(); }
        return;
      }
      if (e.key === 'ArrowLeft') flip(-1);
      else if (e.key === 'ArrowRight') flip(1);
    });
  }

  function goHome() {
    if (gl.homeLink && document.contains(gl.homeLink)) gl.homeLink.click();
  }

  function flip(d) {
    if (!gl.viewer.hidden) return;
    var np = gl.page + d;
    if (np < 1 || np > G_PAGES) return;
    gl.page = np;
    renderGallery();
  }

  function openViewer(id) {
    if (!gl.urls[id]) return;
    if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
    gl.viewerImg.src = gl.urls[id];
    gl.viewer.hidden = false;
  }

  function closeViewer() {
    if (!gl.viewer) return;
    gl.viewer.hidden = true;
    gl.viewerImg.removeAttribute('src');
  }

  function endingName(id) { return id === G_TRUE ? '진엔딩' : '엔딩 ' + id; }

  function galleryPlaceholder(id, missing) {
    var ph = el('div', 'vn-ph gl-ph');
    ph.textContent = endingName(id);
    var sub = el('div', 'vn-ph-sub');
    sub.textContent = missing ? '(이미지를 못 찾았어)' : '(이미지 준비 중)';
    ph.appendChild(sub);
    return ph;
  }

  function makeCell(id, seen) {
    if (id > G_TOTAL) return el('div', 'gl-cell gl-empty');
    if (!seen[id]) {
      var lk = el('div', 'gl-cell gl-locked');
      lk.textContent = '???';
      return lk;
    }
    var btn = el('button', 'gl-cell gl-open');
    btn.type = 'button';
    btn.setAttribute('aria-label', endingName(id));
    var files = endingCandidates(id);
    if (!files.length) {
      btn.appendChild(galleryPlaceholder(id, false));
      return btn;
    }
    var img = el('img');
    img.alt = '';
    img.decoding = 'async';
    if (ENDING_FOCUS[id]) img.style.objectPosition = '50% ' + ENDING_FOCUS[id];
    var tryIdx = 0;
    img.onload = function () { gl.urls[id] = img.currentSrc || img.src; };
    img.onerror = function () {
      tryIdx++;
      if (tryIdx < files.length) { img.src = endingUrl(files[tryIdx]); return; }
      delete gl.urls[id];
      btn.innerHTML = '';
      btn.appendChild(galleryPlaceholder(id, true));
      if (window.console) console.warn('엔딩 이미지를 못 찾았어: ' + endingName(id) + ' (' + files.join(', ') + ')');
    };
    img.src = endingUrl(files[0]);
    btn.appendChild(img);
    btn.addEventListener('click', function () { if (glGuard()) openViewer(id); });
    return btn;
  }

  function renderGallery() {
    var seen = readUnlocked();
    var first = (gl.page - 1) * G_PER_PAGE + 1;
    gl.grid.innerHTML = '';
    for (var i = 0; i < G_PER_PAGE; i++) gl.grid.appendChild(makeCell(first + i, seen));
    gl.label.textContent = '페이지 ' + gl.page + '/' + G_PAGES;
    gl.prev.classList.toggle('gl-off', gl.page <= 1);
    gl.next.classList.toggle('gl-off', gl.page >= G_PAGES);
    var n = 0;
    for (var k = 1; k <= G_NORMAL; k++) if (seen[k]) n++;
    gl.count.textContent = n + '/' + G_NORMAL;
    var nextPage = gl.page + 1;
    setTimeout(function () { prefetchEndings(nextPage); }, 600);     // 지금 페이지 그림이 먼저 오도록 잠깐 뒤에
  }

  /* 다음 페이지에 있는 (해금된) 엔딩 그림을 미리 받아둠 */
  function prefetchEndings(page) {
    if (page > G_PAGES || !gl.root || gl.root.hidden) return;
    var seen = readUnlocked(), first = (page - 1) * G_PER_PAGE + 1;
    gl.pre = [];
    for (var i = 0; i < G_PER_PAGE; i++) {
      var id = first + i, files = endingCandidates(id);
      if (id > G_TOTAL || !seen[id] || !files.length) continue;
      var im = new Image();
      im.src = endingUrl(files[0]);
      gl.pre.push(im);
    }
  }

  function showGallery(p) {
    buildGallery();
    gl.homeLink = p.querySelector('tw-link');
    gl.page = 1;
    closeViewer();
    renderGallery();
    document.body.classList.add('gl-on');
    gl.root.hidden = false;
  }

  function hideGallery() {
    if (!gl.root) return;
    closeViewer();
    document.body.classList.remove('gl-on');
    gl.root.hidden = true;
  }

  /* ================= 타이틀 화면 =================
     'title' 태그가 붙은 패시지에서 동작해. 그림 위에 버튼 4개(2x2)를 올리고,
     버튼을 누르면 패시지 안에 숨어 있는 링크를 대신 눌러줘. (패시지의 링크 글자는 화면에 안 보임)
     - 버튼 위치는 '그림 크기 기준 %' 라서, 화면이 세로로 길어도 그림과 버튼의 위치 관계는 항상 같아.
     - 그림이 화면보다 짧으면 위아래는 같은 그림을 흐리게 늘려서 채워.
     - '용의자 선택'은 엔딩을 한 번이라도 본 적이 있을 때만 켜져. */
  var TT_BUTTONS = [
    { label: '게임 시작',   target: '시작1',             text: '시작1',           cls: 'tt-p', icon: 'play' },
    { label: '게임 방법',   target: '게임 방법',         text: '게임 방법',       cls: 'tt-s', icon: 'help' },
    { label: '엔딩 갤러리', target: '엔딩 갤러리',       text: '엔딩 갤러리',     cls: 'tt-s', icon: 'image' },
    { label: '용의자 선택', target: '제목 없는 구절 15', text: '용의자 선택으로', cls: 'tt-s', icon: 'search', needsRecord: true }
  ];
  var TT_LEGAL = { label: '약관', target: '약관', text: '약관' };   // 타이틀 아래쪽 작은 글씨 버튼 (팬 게임 안내 / 저작권 문구 화면으로 감)
  var TT_TESTS = [
    { label: '기록 초기화',    target: '기록 초기화',    text: '테스트용 기록 초기화' },
    { label: '모든 엔딩 열기', target: '모든 엔딩 열기', text: '테스트용 모든 엔딩 열기' }
  ];
  var TT_ICONS = {
    play:   '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.2v13.6L19.2 12z" fill="currentColor"/></svg>',
    help:   '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.6" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M9.3 9.6a2.8 2.8 0 1 1 4.3 2.3c-.9.6-1.6 1.1-1.6 2.2" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><circle cx="12" cy="16.9" r="1.35" fill="currentColor"/></svg>',
    image:  '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.4" y="4.6" width="17.2" height="14.8" rx="2.6" fill="none" stroke="currentColor" stroke-width="2.4"/><circle cx="9" cy="10" r="1.8" fill="currentColor"/><path d="m4.6 17 4.6-4.4 3.2 3 3.2-3.6 4.2 4.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/></svg>',
    search: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.4" cy="10.4" r="6" fill="none" stroke="currentColor" stroke-width="2.6"/><path d="m15 15 5 5" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>',
    lock:   '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5.4" y="10.6" width="13.2" height="9.6" rx="2.2" fill="currentColor"/><path d="M8.4 10.6V8.2a3.6 3.6 0 0 1 7.2 0v2.4" fill="none" stroke="currentColor" stroke-width="2.4"/></svg>'
  };
  var tt = { root: null, art: null, btns: [], tests: [], panel: null, p: null };

  /* 패시지 안에서 링크 글자가 text 인 링크를 찾음 (Harlowe 링크에는 대상 이름 속성이 없고 화면에 보이는 글자만 있음) */
  function ttLink(p, target, text) {
    if (!p) return null;
    var list = p.querySelectorAll('tw-link');
    for (var i = 0; i < list.length; i++) {
      if (list[i].closest('tw-include')) continue;
      if (list[i].textContent.replace(/^\s+|\s+$/g, '') === text) return list[i];
    }
    return null;
  }

  function ttPress(def) {
    if (Date.now() < lockUntil) return;
    var l = ttLink(tt.p, def.target, def.text);
    if (l && document.contains(l)) l.click();
  }

  function applyTitleArt() {
    if (!tt.root) return;
    tt.root.classList.toggle('tt-noart', titleArt.ok === false);
    tt.root.classList.toggle('tt-edges', !!titleArt.edges);
  }

  function buildTitle() {
    if (tt.root) return;
    var r = el('div');
    r.id = 'tt-root';
    r.hidden = true;
    var blur = el('div', 'tt-blur');
    var stripT = el('div', 'tt-strip tt-strip-t');
    var stripB = el('div', 'tt-strip tt-strip-b');
    tt.art = el('div', 'tt-art');
    tt.art.appendChild(el('div', 'tt-img'));
    var fb = el('div', 'tt-fbtitle');
    fb.innerHTML = '귤복복<br>살인사건';
    tt.art.appendChild(fb);
    TT_BUTTONS.forEach(function (def, i) {
      var b = el('button', 'tt-btn ' + def.cls + ' tt-b' + i);
      b.type = 'button';
      b.innerHTML = '<span class="tt-ico">' + TT_ICONS[def.icon] + '</span><span class="tt-label">' + def.label + '</span>';
      b.addEventListener('click', function () { if (!b.classList.contains('tt-off')) ttPress(def); });
      tt.art.appendChild(b);
      tt.btns.push(b);
    });
    var legal = el('button', 'tt-legal');
    legal.type = 'button';
    legal.textContent = TT_LEGAL.label;
    legal.addEventListener('click', function () { ttPress(TT_LEGAL); });
    tt.art.appendChild(legal);
    r.appendChild(blur);
    r.appendChild(stripT);
    r.appendChild(stripB);
    r.appendChild(tt.art);
    if (SHOW_TEST_MENU) {
      var box = el('div', 'tt-test');
      var chip = el('button', 'tt-chip');
      chip.type = 'button';
      chip.textContent = 'TEST';
      tt.panel = el('div', 'tt-panel');
      tt.panel.hidden = true;
      chip.addEventListener('click', function () { tt.panel.hidden = !tt.panel.hidden; });
      TT_TESTS.forEach(function (def) {
        var tb = el('button', 'tt-chip tt-chip-item');
        tb.type = 'button';
        tb.textContent = def.label;
        tb.addEventListener('click', function () { ttPress(def); });
        tt.panel.appendChild(tb);
      });
      box.appendChild(chip);
      box.appendChild(tt.panel);
      r.appendChild(box);
    }
    document.body.appendChild(r);
    tt.root = r;
    applyTitleArt();
  }

  function showTitle(p) {
    buildTitle();
    tt.p = p;
    TT_BUTTONS.forEach(function (def, i) {
      var b = tt.btns[i];
      var off = !!def.needsRecord && !ttLink(p, def.target, def.text);
      b.classList.toggle('tt-off', off);
      b.setAttribute('aria-disabled', off ? 'true' : 'false');
      b.firstChild.innerHTML = TT_ICONS[off ? 'lock' : def.icon];
      b.title = off ? '엔딩을 한 번이라도 보면 열려요' : '';
    });
    if (tt.panel) tt.panel.hidden = true;
    document.body.classList.add('tt-on');
    tt.root.hidden = false;
  }

  function hideTitle() {
    if (!tt.root) return;
    document.body.classList.remove('tt-on');
    tt.root.hidden = true;
  }

  /* ================= 타이틀로 돌아가기 (홈 버튼) =================
     '타이틀 화면' 과 엔딩 갤러리를 뺀 어느 장면에서든 오른쪽 위에 집 모양 버튼이 떠.
     누르면 한 번 물어보고(HOME_CONFIRM), '홈 버튼 링크' 헤더 패시지에 숨겨둔 링크를 대신 눌러서 타이틀로 가. */
  var HOME_CONFIRM = true;               // false 로 바꾸면 묻지 않고 바로 타이틀로 감
  var hm = { btn: null, dlg: null, back: null };

  /* ================= 이전 대사 보기 (왼쪽 위 화살표) =================
     대화 장면(vn / vn-choice)에서 왼쪽 위에 화살표 버튼이 떠. 누르면 Harlowe 의 '되돌리기'로 바로 앞 장면으로 돌아가.
     - 돌아갈 때 인물 배치도 그 장면의 모습으로 되돌림 (장면마다 배치를 기록해 둠)
     - 타이틀에서 막 시작한 첫 장면에서는 나오지 않음 (돌아갈 곳이 타이틀이라서)
     - 키보드 왼쪽 화살표로도 됨 */
  var hist = [];                          // 지나온 화면들의 기록: { L, R, tags }
  var backPending = false;                // 되돌리기를 눌렀고, 그 결과 화면이 곧 나올 예정

  function undoIcon() {
    return document.querySelector('tw-passage tw-sidebar tw-icon[alt="Undo"]');
  }

  function canGoBack() {
    var ic = undoIcon();
    if (!ic || ic.style.visibility === 'hidden') return false;
    var prev = hist.length >= 2 ? hist[hist.length - 2] : null;
    if (prev && /(^|\s)(title|gallery)(\s|$)/.test(prev.tags)) return false;
    return true;
  }

  function goBack() {
    if (Date.now() < lockUntil || document.body.classList.contains('hm-open')) return;
    var ic = undoIcon();
    if (!ic || ic.style.visibility === 'hidden') return;
    backPending = true;
    setTimeout(function () { backPending = false; }, 800);      // 혹시 되돌려지지 않았을 때를 대비한 안전장치
    ic.click();
  }

  /* 화면 하나를 다 처리한 뒤 호출: 그 화면의 인물 배치를 기록하고, 이전 대사 버튼을 보일지 정함 */
  function finishNav(tags) {
    hist.push({ L: stage.L, R: stage.R, last: stage.last, tags: tags.join(' ') });
    if (hist.length > 500) hist.shift();
    var show = (tags.indexOf('vn') >= 0 || tags.indexOf('vn-choice') >= 0 || tags.indexOf('hub') >= 0) && canGoBack();
    if (hm.back) hm.back.hidden = !show;
  }

  function goTitle() {
    var l = document.querySelector('tw-hook[name="home"] tw-link');
    if (l) l.click(); else location.reload();
  }

  function closeHomeDlg() {
    if (!hm.dlg) return;
    hm.dlg.hidden = true;
    document.body.classList.remove('hm-open');
  }

  function buildHome() {
    if (hm.btn) return;
    hm.btn = el('button', 'gl-btn hm-btn');
    hm.btn.type = 'button';
    hm.btn.setAttribute('aria-label', '타이틀 화면으로');
    hm.btn.innerHTML = ICON_HOME;
    hm.btn.hidden = true;

    hm.back = el('button', 'gl-btn hm-btn hm-back');
    hm.back.type = 'button';
    hm.back.setAttribute('aria-label', '이전 대사');
    hm.back.innerHTML = ICON_PREV;
    hm.back.hidden = true;
    hm.back.addEventListener('click', function () { hm.back.blur(); goBack(); });

    hm.dlg = el('div');
    hm.dlg.id = 'hm-dlg';
    hm.dlg.hidden = true;
    var panel = el('div', 'hm-panel');
    var msg = el('div', 'hm-msg');
    msg.textContent = '타이틀 화면으로 돌아갈까요?';
    var sub = el('div', 'hm-sub');
    sub.textContent = '보던 장면은 저장되지 않습니다.';
    var row = el('div', 'hm-row');
    var yes = el('button', 'gl-btn hm-choice');
    yes.type = 'button';
    yes.textContent = '돌아가기';
    var no = el('button', 'gl-btn hm-choice hm-no');
    no.type = 'button';
    no.textContent = '계속하기';
    row.appendChild(yes);
    row.appendChild(no);
    panel.appendChild(msg);
    panel.appendChild(sub);
    panel.appendChild(row);
    hm.dlg.appendChild(panel);

    hm.btn.addEventListener('click', function () {
      hm.btn.blur();
      if (!HOME_CONFIRM) { goTitle(); return; }
      hm.dlg.hidden = false;
      document.body.classList.add('hm-open');
    });
    yes.addEventListener('click', function () { closeHomeDlg(); goTitle(); });
    no.addEventListener('click', closeHomeDlg);
    hm.dlg.addEventListener('click', function (e) { if (e.target === hm.dlg) closeHomeDlg(); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && document.body.classList.contains('hm-open')) { e.preventDefault(); closeHomeDlg(); }
    });

    document.body.appendChild(hm.btn);
    document.body.appendChild(hm.back);
    document.body.appendChild(hm.dlg);
  }

  function updateHome(tags) {
    buildHome();
    var show = tags.indexOf('title') < 0 && tags.indexOf('gallery') < 0;
    closeHomeDlg();
    hm.btn.hidden = !show;
    document.body.classList.toggle('hm-on', show);
  }

  var sceneSeq = 0;                       // 장면 번호 (기다리는 사이에 다른 장면으로 넘어가면 예전 장면은 취소)

  function onPassage(p) {
    build();
    var seq = ++sceneSeq;
    textEl.classList.remove('vn-loading');
    var tags = (p.getAttribute('tags') || '').split(/\s+/);
    updateHome(tags);
    lockUntil = Date.now() + LOCK_MS;
    if (backPending) {                    // 이전 대사 버튼으로 돌아온 화면: 그때의 인물 배치를 복원
      backPending = false;
      hist.pop();                         // 방금 떠난 화면의 기록
      var snap = hist.pop();              // 돌아온 화면의 예전 기록 (이 화면은 아래에서 다시 기록됨)
      if (snap) { stage.L = snap.L; stage.R = snap.R; stage.last = snap.last || null; saveStage(); }
    }
    if (tags.indexOf('title') < 0) hideTitle();          // 타이틀이 아닌 화면으로 넘어가면 (갤러리 포함) 타이틀 층을 치움
    if (tags.indexOf('gallery') >= 0) { leaveVN(false); showGallery(p); finishNav(tags); return; }
    hideGallery();
    if (tags.indexOf('title') >= 0) { leaveVN(false); showTitle(p); finishNav(tags); return; }
    hideChoices();
    var isHub = tags.indexOf('hub') >= 0, isChoice = isHub || tags.indexOf('vn-choice') >= 0;
    var info = (tags.indexOf('vn') >= 0 || isChoice) ? extract(p, isChoice) : null;
    if (!info) { leaveVN(tags.indexOf('vn-choice') >= 0); finishNav(tags); return; }

    // 이 장면에서 인물들이 지을 표정 (없으면 기본 표정). 선택지 장면은 표시가 없으면 바로 앞 장면의 표정을 그대로 이어감
    var bxs = p.querySelectorAll('[data-bx]');
    if (!isChoice || isHub || bxs.length) sceneExprs = Array.prototype.map.call(bxs, function (b) { return parseBx(b.getAttribute('data-bx')); });
    var parsed = parseSpeaker(info.text);
    placeSpeaker(parsed.speaker);
    var stEl = p.querySelector('[data-stage]');           // 정황상 같이 나와야 하는 사람을 장면 글에서 지정했으면 그대로 보여줌
    if (stEl) applyCast(String(stEl.getAttribute('data-stage')).split(',').map(function (s) { return canon(s.trim()); }));
    finishNav(tags);

    if (parsed.speaker) {
      nameEl.textContent = parsed.speaker;
      nameEl.classList.remove('vn-noname');
    } else {
      nameEl.textContent = '\u00a0';
      nameEl.classList.add('vn-noname');
    }
    document.body.classList.add('vn-on');
    root.hidden = false;
    stopTyping();
    textEl.textContent = '';
    advanceLink = null;                   // 그림이 준비되는 동안은 탭해도 넘어가지 않음

    // 이 장면에 나올 인물 중 아직 못 받은 그림이 있으면, 올 때까지 (최대 WAIT_MAX_MS) 기다렸다가 대사를 시작
    var keyL = exprKey(stage.L), keyR = exprKey(stage.R);
    var pending = [keyL, keyR].filter(function (n) {
      var e = n && sprites[n];
      return n && (!e || e.state === 'loading');
    });
    var released = false, counted = false, timer = null;

    function go() {
      if (released || seq !== sceneSeq) return;
      released = true;
      textEl.classList.remove('vn-loading');
      layoutStage(keyL, keyR);
      advanceLink = info.link;
      if (info.choices) pendingChoice = { items: info.choices, lock: info.lock };
      startTyping(parsed.body);
      if (!typing) typedEnd();
      if (info.link) prefetchAhead(info.link);
    }
    function unhold() {
      if (!counted) return;
      counted = false;
      urgent--;
      if (bgPump) bgPump();
    }
    function done() {
      clearTimeout(timer);
      unhold();
      go();
    }

    if (!pending.length) { go(); return; }
    counted = true;
    urgent++;
    textEl.classList.add('vn-loading');
    var left = pending.length;
    timer = setTimeout(done, WAIT_MAX_MS);
    pending.forEach(function (n) {
      loadSprite(n, function () { left--; if (left <= 0) done(); });
    });
  }

  function check() {
    var all = document.querySelectorAll('tw-passage');
    var p = all.length ? all[all.length - 1] : null;
    if (!p || p === lastPassage) return;
    lastPassage = p;
    setTimeout(function () { onPassage(p); }, 0);
  }

  /* 화면 오른쪽 위에 작게 버전을 보여줌 (어떤 화면에서든 보이고, 누르는 데는 방해 안 됨) */
  function mountVersionTag() {
    if (document.getElementById('ver-tag')) return;
    var v = document.createElement('div');
    v.id = 'ver-tag';
    v.textContent = 'v' + BUILD_VERSION;
    document.body.appendChild(v);
  }

  function start() {
    if (!document.body) { setTimeout(start, 20); return; }
    document.documentElement.style.setProperty('--bg-url', 'url("' + imgUrl(BG_FILE) + '")');
    document.documentElement.style.setProperty('--tt-url', 'url("' + imgUrl(TITLE_FILE) + '")');
    loadStage();
    build();
    mountVersionTag();
    startPreload();
    new MutationObserver(check).observe(document.body, { childList: true, subtree: true });
    check();
  }
  start();
})();

:: StoryStylesheet [stylesheet]
/* ===== 귤복복 살인사건 : 화면 레이아웃 (프로토타입) =====
   조절하고 싶은 숫자는 아래 :root 안의 값만 바꾸면 돼. */
:root {
  --stage-w: min(100vw, calc(100vh * 0.5625));   /* 화면 폭: 폰은 꽉 채우고 PC는 9:16 세로 화면으로 가운데 */
  --u: calc(var(--stage-w) / 100);               /* 화면 폭의 1% */
  --box-h: 28%;                                  /* 대사창 높이 (화면 아래부터) */
  --top-gap: 0.19;                               /* 캐릭터 영역이 시작되는 위치 (화면 위에서부터, 0.19 = 19%) */
  --char-left-w: 0.47;                           /* 왼쪽 캐릭터 칸 너비 (화면 폭의 47%) */
  --char-right-w: 0.50;                          /* 오른쪽 캐릭터 칸 너비 (화면 폭의 50%) */
  --box-color: rgba(12, 24, 48, 0.78);           /* 대사창 색과 투명도 */
  --name-color-a: #e4701a;                       /* 이름표 / 홈 버튼 등 색 (진한 쪽, 해변의 오렌지) */
  --name-color-b: #ffb23c;                       /* 이름표 / 홈 버튼 등 색 (밝은 쪽, 햇살 노랑) */
  --name-shadow: rgba(110, 48, 0, 0.6);          /* 오렌지 위 흰 글자가 잘 읽히도록 까는 그림자 색 */
  --font: "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", "맑은 고딕", sans-serif;
}
:root { --stage-h: 100vh; }
@supports (height: 100dvh) {
  :root {
    --stage-w: min(100vw, calc(100dvh * 0.5625));
    --stage-h: 100dvh;
  }
}

html, body {
  margin: 0;
  height: 100%;
  overflow: hidden;
  background: #000;
}

/* 맨 뒤 배경: 모든 장면에 깔림 */
tw-story {
  position: fixed !important;
  top: 0;
  bottom: 0;
  left: 50%;
  width: var(--stage-w);
  margin: 0 !important;
  padding: 0 !important;
  transform: translateX(-50%);
  background-color: #7ec8f0 !important;
  background-image: var(--bg-url, none) !important;
  background-size: cover !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
  overflow-x: hidden;
  overflow-y: auto;
  font-family: var(--font);
  color: #fff;
}

/* 대화 장면이 아닌 일반 화면(타이틀, 선택지 등)은 어두운 반투명 판 위에 글자 */
tw-passage {
  display: block;
  box-sizing: border-box;
  margin: calc(var(--u) * 5);
  padding: calc(var(--u) * 5);
  background: rgba(8, 16, 34, 0.72);
  border-radius: calc(var(--u) * 3);
  color: #fff;
  font-family: var(--font);
  font-size: calc(var(--u) * 4.4);
  line-height: 1.6;
  word-break: keep-all;
}
/* 되돌리기/다시 실행 아이콘은 오른쪽 위 모서리에 작게 */
tw-passage { position: relative; }
tw-passage tw-sidebar {
  position: absolute;
  top: calc(var(--u) * 2);
  right: calc(var(--u) * 2);
  left: auto;
  width: auto;
  height: auto;
  margin: 0;
  flex-direction: row;
}
tw-passage tw-sidebar tw-icon { font-size: calc(var(--u) * 6); margin: 0 calc(var(--u) * 1); }

tw-passage tw-link,
tw-passage .enchantment-link { color: #ffd48a; }
tw-passage tw-link:hover,
tw-passage .enchantment-link:hover { color: #ffffff; }
/* 이미 가본 링크(타이틀 화면 등)도 같은 색으로: Harlowe 기본 보라색이 어두운 글판에서 안 보임 */
tw-passage tw-link.visited,
tw-passage .enchantment-link.visited { color: #ffd48a; }
tw-passage tw-link.visited:hover,
tw-passage .enchantment-link.visited:hover { color: #ffffff; }

/* 대화 장면에서는 Harlowe 원래 글자와 링크를 숨김 (내용은 스크립트가 읽어서 대사창에 넣음) */
body.vn-on tw-passage { display: none; }

/* ===== 대화 장면 층 ===== */
#vn-root {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 50%;
  width: var(--stage-w);
  transform: translateX(-50%);
  z-index: 5;
  overflow: hidden;
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
  font-family: var(--font);
}
#vn-root[hidden] { display: none; }

.vn-slot {
  position: absolute;
  top: calc(var(--top-gap) * 100%);
  bottom: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.vn-slot.vn-left  { left: 0;  width: calc(var(--char-left-w) * 100%);  --slot-w: calc(var(--stage-w) * var(--char-left-w)); }
.vn-slot.vn-right { right: 0; width: calc(var(--char-right-w) * 100%); --slot-w: calc(var(--stage-w) * var(--char-right-w)); }

/* 인물 그림이 나오는 칸: 화면 전체를 덮고, 그림은 계산된 위치와 크기로 놓임 (앞뒤 순서는 스크립트가 z-index 로 정함) */
.vn-slot.vn-norm { left: 0; right: 0; top: 0; width: 100%; display: block; pointer-events: none; }
.vn-slot.vn-norm.vn-left { z-index: 2; }    /* 겹칠 때는 왼쪽(벨)이 앞에 오게 */
.vn-slot.vn-norm.vn-right { z-index: 1; }
.vn-sprite {
  position: absolute;
  max-width: none;
  max-height: none;
  pointer-events: none;
}

/* 이미지가 아직 없는 인물은 이름 적힌 임시 상자로 표시 */
.vn-ph {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding-top: calc(var(--u) * 6);
  background: rgba(110, 110, 120, 0.5);
  border: calc(var(--u) * 0.5) dashed rgba(255, 255, 255, 0.7);
  color: #fff;
  font-size: calc(var(--u) * 5);
  font-weight: 700;
  text-align: center;
  text-shadow: 0 0 calc(var(--u) * 1) rgba(0, 0, 0, 0.8);
}
.vn-ph-sub {
  margin-top: calc(var(--u) * 2);
  font-size: calc(var(--u) * 3.4);
  font-weight: 400;
}

/* 대사창 */
.vn-box {
  position: absolute;
  z-index: 10;              /* 인물 그림(z-index 1~2)보다 항상 위 */
  left: 0;
  right: 0;
  bottom: 0;
  height: var(--box-h);
  display: flex;
  flex-direction: column;
  background: var(--box-color);
  color: #fff;
}

/* 이름표: 도트 무늬가 살짝 들어간 파란 띠 */
.vn-name {
  flex: 0 0 auto;
  padding: calc(var(--u) * 1.6) calc(var(--u) * 4.5);
  font-size: calc(var(--u) * 4.8);
  font-weight: 700;
  letter-spacing: 0.02em;
  background:
    radial-gradient(rgba(255, 255, 255, 0.16) 1px, transparent 1.4px) 0 0 / 4px 4px,
    linear-gradient(90deg, var(--name-color-a), var(--name-color-b));
}
.vn-name.vn-noname { visibility: hidden; }

.vn-text {
  flex: 1 1 auto;
  padding: calc(var(--u) * 3.5) calc(var(--u) * 4.5);
  font-size: calc(var(--u) * 4.4);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: keep-all;
  overflow-wrap: anywhere;
  overflow-y: auto;
}

/* ===== 선택지 띠 (선택지가 있는 장면: 대사가 끝나면 대사창 위 빈 공간에 위에서부터 차례로 나타남) ===== */
.vn-choices {
  position: absolute;
  z-index: 6;               /* 인물 그림(1~2) 위, 대사창(10) 아래 */
  left: 0;
  right: 0;
  top: calc(var(--u) * 11);                                   /* 왼쪽 위 버튼들 아래부터 */
  bottom: calc(var(--box-h) + var(--u) * 2);
  display: grid;
  grid-template-rows: repeat(var(--n, 2), 1fr);               /* 선택지 수만큼 위아래로 고르게 나눔 */
  pointer-events: none;
}
.vn-choices[hidden] { display: none; }
.vn-ch {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 0;
  margin: 0;
  padding: 0 calc(var(--u) * 5);
  border: 0;
  background: none;         /* 눌리는 칸은 칸 전체, 눈에 보이는 띠는 ::before */
  color: #fff;
  font: inherit;
  font-size: calc(var(--u) * 5);
  font-weight: 700;
  line-height: 1.3;
  text-align: left;
  cursor: pointer;
  pointer-events: auto;
  -webkit-tap-highlight-color: transparent;
  animation: vn-ch-in 0.3s ease-out both;
  animation-delay: calc(var(--i, 0) * 110ms);
}
.vn-ch::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: min(60%, calc(var(--u) * 16));
  transform: translateY(-50%);
  background: rgba(0, 0, 0, 0.62);
  border-left: calc(var(--u) * 1.4) solid var(--name-color-a);
  transition: background 0.12s;
}
.vn-ch:hover::before, .vn-ch:active::before, .vn-ch:focus-visible::before { background: rgba(0, 0, 0, 0.8); }
.vn-ch:focus { outline: none; }
.vn-ch-t {
  position: relative;
  display: block;
  min-width: 0;
  text-shadow: 0 calc(var(--u) * 0.2) calc(var(--u) * 0.8) rgba(0, 0, 0, 0.6);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.vn-ch-lock { cursor: default; pointer-events: none; }
.vn-ch-lock::before { background: rgba(0, 0, 0, 0.42); border-left-color: rgba(255, 255, 255, 0.35); }
.vn-ch-lock .vn-ch-t { color: rgba(255, 255, 255, 0.6); font-weight: 400; }
@keyframes vn-ch-in {
  from { opacity: 0; transform: translateX(calc(var(--u) * -6)); }
  to   { opacity: 1; transform: none; }
}

/* ===== 엔딩 갤러리 ===== */
body.gl-on tw-passage { display: none; }

#gl-root {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 50%;
  width: var(--stage-w);
  transform: translateX(-50%);
  z-index: 6;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: rgba(6, 12, 28, 0.58);
  color: #fff;
  font-family: var(--font);
  user-select: none;
  -webkit-user-select: none;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}
#gl-root[hidden] { display: none; }

/* 위쪽: 제목 + 오른쪽 위 홈 버튼 */
.gl-head {
  position: relative;
  flex: 0 0 auto;
  height: calc(var(--u) * 15);
  display: flex;
  align-items: center;
  justify-content: center;
}
.gl-title {
  font-size: calc(var(--u) * 5.6);
  font-weight: 700;
  letter-spacing: 0.02em;
  text-shadow: 0 0 calc(var(--u) * 1.2) rgba(0, 0, 0, 0.85);
}
.gl-count {
  margin-left: calc(var(--u) * 2.5);
  font-size: calc(var(--u) * 3.6);
  font-weight: 400;
  opacity: 0.85;
}

/* 버튼 공통: 대사창 이름표와 같은 파란 계열 */
.gl-btn {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-family: inherit;
  cursor: pointer;
  background:
    radial-gradient(rgba(255, 255, 255, 0.16) 1px, transparent 1.4px) 0 0 / 4px 4px,
    linear-gradient(135deg, var(--name-color-a), var(--name-color-b));
  border: calc(var(--u) * 0.6) solid rgba(255, 255, 255, 0.75);
  border-radius: calc(var(--u) * 2.4);
}
.gl-btn:active { transform: scale(0.94); }
.gl-btn:focus-visible { outline: calc(var(--u) * 0.8) solid #ffe3b0; outline-offset: calc(var(--u) * 0.6); }
.gl-btn svg { width: 58%; height: 58%; display: block; }

.gl-home {
  position: absolute;
  right: calc(var(--u) * 3.5);
  top: 50%;
  margin-top: calc(var(--u) * -5.5);
  width: calc(var(--u) * 11);
  height: calc(var(--u) * 11);
}

/* 가운데: 2열 x 3행 */
.gl-grid {
  flex: 1 1 auto;
  min-height: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: repeat(3, minmax(0, 1fr));
  gap: calc(var(--u) * 3.5) calc(var(--u) * 4);
  padding: 0 calc(var(--u) * 3.5);
}
.gl-cell {
  position: relative;
  box-sizing: border-box;
  min-width: 0;
  min-height: 0;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border-radius: calc(var(--u) * 2.4);
  border: calc(var(--u) * 0.6) solid rgba(255, 255, 255, 0.6);
  background: rgba(12, 24, 48, 0.78);
  color: #fff;
  font-family: inherit;
}
.gl-cell.gl-empty { visibility: hidden; }
.gl-cell.gl-locked {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(var(--u) * 9);
  font-weight: 700;
  letter-spacing: 0.06em;
  color: rgba(255, 255, 255, 0.55);
  border-style: dashed;
  border-color: rgba(255, 255, 255, 0.35);
}
.gl-cell.gl-open { cursor: pointer; }
.gl-cell.gl-open:active { transform: scale(0.97); }
.gl-cell.gl-open:focus-visible { outline: calc(var(--u) * 0.8) solid #ffe3b0; outline-offset: calc(var(--u) * 0.6); }
.gl-cell img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  max-width: none;
  object-fit: cover;
  object-position: center top;   /* 썸네일은 그림의 위쪽(얼굴)이 보이게 맞춤. 값 앞의 center 는 가로 위치, top 은 세로 위치 */
  pointer-events: none;
}
.gl-cell .gl-ph { border: 0; background: transparent; }

/* 아래쪽: 이전 / 페이지 / 다음 */
.gl-foot {
  flex: 0 0 auto;
  height: calc(var(--u) * 18);
  padding: 0 calc(var(--u) * 3.5);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.gl-page {
  font-size: calc(var(--u) * 4.6);
  text-shadow: 0 0 calc(var(--u) * 1.2) rgba(0, 0, 0, 0.85);
}
.gl-nav {
  width: calc(var(--u) * 13);
  height: calc(var(--u) * 11);
}
.gl-nav.gl-off { visibility: hidden; }

/* 그림 크게 보기: 거의 꽉 차지만 전체화면은 아님. 아무 데나 누르면 닫힘 */
.gl-viewer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(var(--u) * 3);
  background: rgba(0, 0, 0, 0.9);
  cursor: pointer;
  animation: gl-fade 0.15s ease-out;
}
.gl-viewer[hidden] { display: none; }
.gl-viewer img {
  display: block;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  border-radius: calc(var(--u) * 2.4);
  box-shadow: 0 0 calc(var(--u) * 5) rgba(0, 0, 0, 0.7);
}
@keyframes gl-fade { from { opacity: 0; } to { opacity: 1; } }
@media (prefers-reduced-motion: reduce) {
  .gl-viewer { animation: none; }
  .gl-btn:active, .gl-cell.gl-open:active { transform: none; }
}

/* ===== 타이틀로 돌아가기 (홈 버튼) ===== */
tw-hook[name="home"] { display: none; }
.hm-btn {
  position: fixed;
  top: calc(var(--u) * 3);
  left: calc(50% + var(--stage-w) / 2 - var(--u) * 13.5);
  width: calc(var(--u) * 10);
  height: calc(var(--u) * 10);
  z-index: 8;
}
.hm-btn[hidden] { display: none; }
/* 버전 표시: 오른쪽 위 구석에 아주 작게 */
#ver-tag {
  position: fixed;
  top: calc(var(--u) * 0.8);
  left: calc(50% + var(--stage-w) / 2 - var(--u) * 1.5);
  transform: translateX(-100%);
  z-index: 100000;
  font: 600 calc(var(--u) * 2.6) / 1 var(--font);
  color: rgba(255, 255, 255, 0.85);
  text-shadow: 0 0 calc(var(--u) * 0.6) rgba(0, 0, 0, 0.75), 0 0 calc(var(--u) * 0.3) rgba(0, 0, 0, 0.9);
  pointer-events: none;
  user-select: none;
  -webkit-user-select: none;
}
/* 이전 대사 버튼: 홈 버튼과 같은 모양, 왼쪽 위 */
.hm-back { left: calc(50% - var(--stage-w) / 2 + var(--u) * 3.5); }
/* 홈 / 이전 대사 버튼이 있을 때는 일반 화면(선택지, 엔딩 글 등)의 글판을 버튼 아래로 내려서 글자를 가리지 않게 함 */
body.hm-on tw-passage { margin-top: calc(var(--u) * 17); }
/* 홈 버튼이 있을 때는 Harlowe 되돌리기 아이콘을 왼쪽으로 비켜줌 */
body.hm-on tw-passage tw-sidebar { right: calc(var(--u) * 10); }

#hm-dlg {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 50%;
  width: var(--stage-w);
  transform: translateX(-50%);
  z-index: 9;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-family: var(--font);
  -webkit-tap-highlight-color: transparent;
}
#hm-dlg[hidden] { display: none; }
.hm-panel {
  box-sizing: border-box;
  width: 84%;
  padding: calc(var(--u) * 6) calc(var(--u) * 5);
  border-radius: calc(var(--u) * 3);
  border: calc(var(--u) * 0.6) solid rgba(255, 255, 255, 0.6);
  background: rgba(8, 16, 34, 0.96);
  text-align: center;
}
.hm-msg { font-size: calc(var(--u) * 5); font-weight: 700; }
.hm-sub { margin-top: calc(var(--u) * 2); font-size: calc(var(--u) * 3.6); opacity: 0.85; }
.hm-row { margin-top: calc(var(--u) * 5); display: flex; gap: calc(var(--u) * 3); }
.hm-choice { flex: 1 1 0; height: calc(var(--u) * 11); font-size: calc(var(--u) * 4.4); font-weight: 700; }
.hm-choice.hm-no { background: rgba(255, 255, 255, 0.14); }

/* ===== 타이틀 화면 ===== */
body.tt-on tw-passage { display: none; }

#tt-root {
  --aw: min(var(--stage-w), calc(var(--stage-h) * 0.5596));   /* 그림 가로 폭 (그림 비율 399:713 유지) */
  --au: calc(var(--aw) / 100);                                 /* 그림 폭의 1% */
  position: fixed;
  top: 0;
  bottom: 0;
  left: 50%;
  width: var(--stage-w);
  transform: translateX(-50%);
  z-index: 7;
  overflow: hidden;
  background: #7ec8f0;
  font-family: var(--font);
  user-select: none;
  -webkit-user-select: none;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}
#tt-root[hidden] { display: none; }
#tt-root.tt-noart { background: transparent; }

/* 화면이 그림보다 세로로 길 때 남는 위아래를 같은 그림을 흐리게 늘려서 채움 */
.tt-blur {
  position: absolute;
  top: -6%;
  right: -6%;
  bottom: -6%;
  left: -6%;
  background: var(--tt-url, none) center / cover no-repeat;
  filter: blur(calc(var(--u) * 3)) saturate(1.1);
  transform: translateZ(0);
}
.tt-noart .tt-blur, .tt-edges .tt-blur { display: none; }

/* 그림 가장자리 색을 위아래로 이어 붙인 띠 (스크립트가 --tt-top / --tt-bot 을 채움) */
.tt-strip { display: none; position: absolute; left: 0; right: 0; height: 52%; }
.tt-edges .tt-strip { display: block; }
.tt-noart .tt-strip { display: none; }
.tt-strip-t { top: 0; background: var(--tt-top, none); }
.tt-strip-b { bottom: 0; background: var(--tt-bot, none); }

/* 그림 본체. 버튼은 이 상자 안에서 % 로 자리를 잡음 (그림이 곧 도화지) */
.tt-art {
  position: absolute;
  left: 50%;
  top: 50%;
  width: var(--aw);
  height: calc(var(--aw) * 713 / 399);
  transform: translate(-50%, -50%);
}
/* 그림 층: 화면이 그림보다 길 때만 위아래 가장자리를 부드럽게 섞음 (안 길면 섞는 폭이 0) */
.tt-img {
  --fz: max(0px, min(calc(var(--stage-h) - var(--aw) * 713 / 399), calc(var(--aw) * 0.09)));
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--tt-url, none) center / 100% 100% no-repeat;
  -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 var(--fz), #000 calc(100% - var(--fz)), transparent 100%);
  mask-image: linear-gradient(to bottom, transparent 0, #000 var(--fz), #000 calc(100% - var(--fz)), transparent 100%);
}
.tt-noart .tt-img { display: none; }

/* 그림 파일이 없을 때만 보이는 임시 제목 */
.tt-fbtitle { display: none; }
.tt-noart .tt-fbtitle {
  display: block;
  position: absolute;
  left: 0;
  right: 0;
  top: 10%;
  text-align: center;
  font-size: calc(var(--au) * 15);
  font-weight: 900;
  line-height: 1.15;
  color: #e898d8;
  -webkit-text-stroke: calc(var(--au) * 1.2) #fff;
  paint-order: stroke fill;
  text-shadow: 0 calc(var(--au) * 1) calc(var(--au) * 1.5) rgba(0, 0, 0, 0.35);
}

/* 버튼 4개: 2열 x 2행. 좌우 여백 5.5%, 열 사이 7%, 그림 아래쪽 근처 */
.tt-btn {
  --edge: #0c5a70;
  position: absolute;
  box-sizing: border-box;
  width: 41%;
  height: 10.4%;
  margin: 0;
  padding: 0 calc(var(--au) * 1.5);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: calc(var(--au) * 1.8);
  font-family: inherit;
  font-size: calc(var(--au) * 4.4);
  font-weight: 800;
  letter-spacing: 0.01em;
  white-space: nowrap;
  color: #fff;
  cursor: pointer;
  border: calc(var(--au) * 0.9) solid #fff8e4;
  border-radius: calc(var(--au) * 4.6);
  text-shadow: 0 calc(var(--au) * 0.5) 0 var(--edge), 0 0 calc(var(--au) * 1.4) rgba(0, 0, 0, 0.25);
  box-shadow:
    0 calc(var(--au) * 1.3) 0 var(--edge),
    0 calc(var(--au) * 2.8) calc(var(--au) * 3.2) rgba(6, 36, 56, 0.4),
    inset 0 calc(var(--au) * 0.5) 0 rgba(255, 255, 255, 0.5);
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}
.tt-btn::before {                       /* 윗면 반짝임 */
  content: '';
  position: absolute;
  left: 5%;
  right: 5%;
  top: 6%;
  height: 40%;
  border-radius: calc(var(--au) * 3.4);
  background: linear-gradient(rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.05));
  pointer-events: none;
}
.tt-btn.tt-p {                          /* 게임 시작: 햇살 (그림의 꽃과 모자 안쪽 주황) */
  --edge: #a2500c;
  background:
    radial-gradient(rgba(255, 255, 255, 0.18) 1px, transparent 1.4px) 0 0 / 4px 4px,
    linear-gradient(180deg, #ffd964 0%, #ffb236 52%, #f28a1f 100%);
}
.tt-btn.tt-s {                          /* 나머지: 바다 (그림의 목걸이와 팔찌 청록) */
  --edge: #0c5a70;
  background:
    radial-gradient(rgba(255, 255, 255, 0.16) 1px, transparent 1.4px) 0 0 / 4px 4px,
    linear-gradient(180deg, #4fd0c8 0%, #25a0aa 55%, #1b7f97 100%);
}
.tt-b0 { left: 5.5%;  top: 74.6%; }
.tt-b1 { left: 53.5%; top: 74.6%; }
.tt-b2 { left: 5.5%;  top: 86.8%; }
.tt-b3 { left: 53.5%; top: 86.8%; }
.tt-legal {                             /* 약관: 버튼 아래 한 줄짜리 작은 글씨 */
  position: absolute;
  left: 50%;
  top: 96.9%;
  transform: translateX(-50%);
  margin: 0;
  padding: calc(var(--au) * 1) calc(var(--au) * 5);
  font-family: inherit;
  font-size: calc(var(--au) * 3.4);
  font-weight: 700;
  color: #fff;
  background: none;
  border: 0;
  text-decoration: underline;
  text-underline-offset: calc(var(--au) * 0.6);
  text-shadow: 0 0 calc(var(--au) * 1.2) rgba(0, 0, 0, 0.7), 0 calc(var(--au) * 0.3) 0 rgba(0, 0, 0, 0.4);
  opacity: 0.92;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}
.tt-legal:focus-visible { outline: calc(var(--au) * 0.6) solid #fff; }
.tt-btn:active { transform: translateY(calc(var(--au) * 1)); box-shadow: 0 calc(var(--au) * 0.3) 0 var(--edge), 0 calc(var(--au) * 1.2) calc(var(--au) * 2) rgba(6, 36, 56, 0.4), inset 0 calc(var(--au) * 0.5) 0 rgba(255, 255, 255, 0.5); }
.tt-btn:focus-visible { outline: calc(var(--au) * 0.9) solid #fff; outline-offset: calc(var(--au) * 0.6); }
.tt-btn.tt-off {                        /* 잠긴 버튼 */
  filter: grayscale(0.9) brightness(0.92);
  opacity: 0.78;
  cursor: default;
}
.tt-btn.tt-off:active { transform: none; }
.tt-ico { display: flex; width: calc(var(--au) * 5.6); height: calc(var(--au) * 5.6); }
.tt-ico svg { width: 100%; height: 100%; display: block; filter: drop-shadow(0 calc(var(--au) * 0.5) 0 var(--edge)); }
.tt-label { position: relative; }

/* 테스트용 버튼 (왼쪽 위). SHOW_TEST_MENU 를 false 로 하면 안 생김 */
.tt-test { position: absolute; left: calc(var(--u) * 1.5); top: calc(var(--u) * 1.5); z-index: 2; display: flex; flex-direction: column; align-items: flex-start; gap: calc(var(--u) * 1); }
.tt-panel { display: flex; flex-direction: column; align-items: flex-start; gap: calc(var(--u) * 1); }
.tt-panel[hidden] { display: none; }
.tt-chip {
  margin: 0;
  padding: calc(var(--u) * 0.8) calc(var(--u) * 2);
  font-family: inherit;
  font-size: calc(var(--u) * 3);
  color: #fff;
  background: rgba(0, 0, 0, 0.42);
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: calc(var(--u) * 2);
  cursor: pointer;
}
.tt-chip-item { font-size: calc(var(--u) * 3.2); background: rgba(0, 0, 0, 0.62); }

/* ===== 불러오는 중 화면 (나중에 예쁘게 바꿀 때는 이 부분과 스크립트의 buildLoading / setLoading / hideLoading 만 고치면 돼) ===== */
#ld-root {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 50%;
  width: var(--stage-w);
  transform: translateX(-50%);
  z-index: 20;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: calc(var(--u) * 4);
  background: #060c1c;
  color: #fff;
  font-family: var(--font);
  user-select: none;
  -webkit-user-select: none;
  -webkit-tap-highlight-color: transparent;
}
#ld-root[hidden] { display: none; }
.ld-title { font-size: calc(var(--u) * 7); font-weight: 700; letter-spacing: 0.02em; }
.ld-bar {
  box-sizing: border-box;
  width: 64%;
  height: calc(var(--u) * 2.6);
  border-radius: calc(var(--u) * 1.3);
  border: calc(var(--u) * 0.4) solid rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.12);
  overflow: hidden;
}
.ld-fill {
  width: 0;
  height: 100%;
  background: linear-gradient(90deg, var(--name-color-a), var(--name-color-b));
  transition: width 0.25s ease-out;
}
.ld-msg { font-size: calc(var(--u) * 3.8); opacity: 0.85; }
.ld-skip { padding: 0 calc(var(--u) * 6); height: calc(var(--u) * 11); font-size: calc(var(--u) * 4.2); font-weight: 700; }
.ld-skip[hidden] { display: none; }

/* 인물 그림을 기다리는 동안 대사창에 점 세 개가 깜빡임 */
.vn-text.vn-loading::after { content: '…'; opacity: 0.6; animation: ld-blink 1s ease-in-out infinite; }
@keyframes ld-blink { 0%, 100% { opacity: 0.15; } 50% { opacity: 0.8; } }
@media (prefers-reduced-motion: reduce) {
  .vn-text.vn-loading::after { animation: none; }
  .ld-fill { transition: none; }
}

/* ===== 오렌지 테마 보정: 밝은 오렌지 위에서도 흰 글자와 아이콘이 잘 읽히도록 ===== */
.vn-name { text-shadow: 0 calc(var(--u) * 0.4) 0 var(--name-shadow); }
.gl-btn { text-shadow: 0 calc(var(--u) * 0.4) 0 var(--name-shadow); }
.gl-btn svg { filter: drop-shadow(0 calc(var(--u) * 0.4) 0 var(--name-shadow)); }
