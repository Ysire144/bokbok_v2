[[엔딩 갤러리 3페이지]]


:: StoryScript [script]
window.BB = {
  key: 'bokbok-seen:0DA91373-B868-486A-8A93-E58F30DDAC24',
  load: function () {
    try {
      var raw = window.localStorage.getItem(this.key);
      var arr = raw ? JSON.parse(raw) : [];
      return Array.isArray(arr) ? arr : [];
    } catch (e) { return []; }
  },
  save: function (arr) {
    try { window.localStorage.setItem(this.key, JSON.stringify(arr)); } catch (e) {}
  },
  clear: function () {
    try { window.localStorage.removeItem(this.key); } catch (e) {}
  }
};

/* ===== 귤복복 살인사건 : 대화 장면 처리 =====
   'vn' 태그가 붙은 패시지에서 동작해. (선택지가 하나뿐인 장면 전부)
   'vn-choice' 태그: 선택지가 둘인 장면. 'hub' 태그: 용의자 선택 화면. 둘 다 대사가 끝나면 반투명한 띠 모양 선택지가 위에서부터 떠.
