  var IMAGE_BASE = (location.protocol === 'file:') ? LOCAL_BASE : WEB_BASE;
  // 웹에서는 용량을 줄인 .webp 를 먼저 찾고, 없으면 .png 를 씀. (내 컴퓨터에서 파일로 열 때는 원본 .png 만 씀)
