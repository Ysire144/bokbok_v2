    '포포|11호': { f: 'R' }, '포포|귤복복': { f: 'R', a: -4.5, b: 6 }, '포포|남궁우': { a: -6, b: 3 }, '포포|네코미야': { f: 'R' },
    '포포|니콜': { f: 'R', b: 3 }, '포포|다이아린': { f: 'R', a: -3, b: 6 }, '포포|레미엘': { a: -6, b: 6 }, '포포|록시': { f: 'R', b: 1.5 },
    '포포|루시아': { f: 'R', b: 4.5 }, '포포|미야비': { f: 'R', a: -4.5, b: 6 }, '포포|반악': { b: 3 }, '포포|버니스': { f: 'R', b: 6 },
    '포포|벨리나': { b: 3 }, '포포|빛나': { f: 'R', a: -6, b: 6 }, '포포|수나': { f: 'R', b: 4.5 }, '포포|시드': { f: 'R' },
    '포포|시시아': { f: 'R', a: -6, b: 6 }, '포포|아리아': { f: 'R', a: -6, b: 6 }, '포포|아스트라': { a: -1.5, b: 4.5 }, '포포|앨리스': { f: 'R', b: 4.5 },
